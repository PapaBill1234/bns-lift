// VERSIONINFO of the original CacheGate.exe (Service_348_8349). Daemon::LoadVersion (0xbb30) reads it.
// The values come from the original resource. Language 0x0412, code page 1200.
1 VERSIONINFO
 FILEVERSION 0,0,348,524
 PRODUCTVERSION 0,0,348,524
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName", "NCSoft"
            VALUE "FileDescription", "Blade & Soul CacheGate"
            VALUE "FileVersion", "0, 0, 348, 524"
            VALUE "InternalName", "CacheGate"
            VALUE "LegalCopyright", "Copyright (C) 2007-2009, Team Bloodlust, NCSoft Corporation. All Rights Reserved."
            VALUE "OriginalFilename", "CacheGate.exe"
            VALUE "ProductName", "Blade & Soul CacheGate"
            VALUE "ProductVersion", "0, 0, 348, 524"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END
