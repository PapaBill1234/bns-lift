+// 0x28AB0 (PostOfficeDaemon)
+bool Network::OpenPort(unsigned int portId, unsigned short portNo, int purpose, SessionHandler const* sessionHandler,
+                       PacketBufferHandler const* bufferHandler, unsigned int maxSession, bool autoOpen, bool nagle)
+{
+    if (portId == 0)
+        NETWORK_ASSERT_CRASH(170);
+    if (purpose != 2 && purpose != 3)
+        NETWORK_ASSERT_CRASH(175);
+    if (Instance->_port[portId - 1] != nullptr)
+        NETWORK_ASSERT_CRASH(177);
+
+    if (maxSession == 0)
+    {
+        if (purpose == 2 || purpose == 3)
+        {
+            maxSession = 2 * Instance->_workerThreadCount + 1;
+            if (s_defaultMaxSession[purpose] > maxSession)
+                maxSession = s_defaultMaxSession[purpose];
+        }
+        else
+        {
+            maxSession = s_defaultMaxSession[purpose];
+        }
+    }
+
+    void* memory = BaseMemoryManager::_Instance.Alloc(sizeof(Port), NETWORK_FILE, 184);  // ❓ line (LTCG dropped it)
+    Port* port = memory != nullptr ? new (memory) Port() : nullptr;
+    // The PostOfficeDaemon Port::Initialize (0x361D0) has no enableRecv parameter.
+    if (!port->Initialize(portId, portNo, maxSession, purpose, true, nagle, Instance->_iocpHandle, sessionHandler,
+                          bufferHandler))
+    {
+        if (port != nullptr)
+            port->~Port();
+        BaseMemoryManager::_Instance.Free(port, NETWORK_FILE, 188);
+        return false;
+    }
+    if (port->_portNumber != 0)
+    {
+        if (!port->StartAccept())
+        {
+            port->clearPool();
+            port->~Port();
+            BaseMemoryManager::_Instance.Free(port, NETWORK_FILE, 194);
+            return false;
+        }
+    }
+    port->_enableRecv = true;
+    if (!autoOpen)
+        port->_enableAccept = false;
+    Instance->_port[portId - 1] = port;
+    return true;
+}
