// msvcp100.dll exports. They throw the std exception. The build links an import lib
// for msvcp100.dll (see CMakeLists.txt, LIFT_MSVCP100_IMPLIB).
// clang makes destructors noexcept and calls __std_terminate (vcruntime140) when a noexcept
// function throws. msvcr100 does not export it. The Wine import lib for msvcr100 has no C++
// names (no ?terminate@@YAXXZ), so do the same as msvcr100 terminate(): call the handler
// from _get_terminate(), then abort(). It is a COMDAT (inline + used), so each object can have a copy.
extern "C" {
typedef void(__cdecl* _lift_terminate_handler)();
__declspec(dllimport) _lift_terminate_handler __cdecl _get_terminate();
[[noreturn]] inline __attribute__((used)) void __cdecl __std_terminate()
{
    _lift_terminate_handler handler = _get_terminate();
    if (handler != 0)
        handler();
    abort();
}
}

